# AI provider and social platform credentials are managed in the app (Settings), not here.

# App
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENV=development
DEMO_MODE=true
CORS_ORIGINS=http://localhost:5173

# Database / Redis
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/smhub
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
TOKEN_ENCRYPTION_KEY=

# Email (SMTP) - used for team invitations
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Feedwren

