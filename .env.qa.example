# QA server (10.0.0.16). Copy to .env and fill the secrets. Only nginx is published, on port 8014.
APP_URL=http://10.0.0.16:8014
FRONTEND_URL=http://10.0.0.16:8014
CORS_ORIGINS=http://10.0.0.16:8014
ENV=production
DEMO_MODE=false

# External Postgres on the QA network (REDIS_URL is set by compose itself)
DATABASE_URL=postgresql+psycopg2://postgres:<password>@10.0.0.15:5432/smhub

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
TOKEN_ENCRYPTION_KEY=

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=Feedwren
